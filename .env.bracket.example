# =====================================================================
#  BRACKET: трендовый скальпер с лимитным входом + TP/SL на US500 и золото.
#  Локально: cp .env.bracket.example .env.bracket -> make br-check -> make br-up
#  На сервер:  cp .env.bracket.example envs/gold.env -> ./deploy/deploy.sh root@IP envs/gold.env gridbot-gold
# =====================================================================
STRATEGY=bracket

# приватный Ed25519 ключ ДРУГОГО аккаунта, scope "trade"
VAR_API_SECRET=
VAR_BASE_URL=https://api.omni.testnet.variational.io
VAR_ENVIRONMENT=testnet

# Инструменты через запятую (TradFi-рынки: бот сам ждёт открытия сессии)
BRACKET_SYMBOLS=US500-PERP,XAU-PERP

# Размер сделки: маржа × плечо рынка (плечо из аккаунта). Либо объём напрямую в BRACKET_NOTIONAL_USDC
BRACKET_MARGIN_USDC=100
BRACKET_NOTIONAL_USDC=

# Выход: take-profit и stop-loss в % от цены входа (ставятся сразу вместе со входом)
BRACKET_TP_PCT=0.10
BRACKET_SL_PCT=0.20

# Вход: лимитка на N базисных пунктов (0.01%) лучше mark; не исполнилась за TTL — переставить
BRACKET_ENTRY_OFFSET_BPS=1
BRACKET_ENTRY_TTL_SEC=90

# Держать позицию не дольше N минут (потом закрыть по рынку); пауза после выхода
BRACKET_MAX_HOLD_MIN=30
BRACKET_COOLDOWN_SEC=30

# Сигнал: быстрая/медленная EMA по mark price, сэмпл раз в BRACKET_POLL_SEC секунд
BRACKET_POLL_SEC=10
BRACKET_FAST=12
BRACKET_SLOW=48
BRACKET_MIN_SAMPLES=6

# За сколько минут до закрытия торговой сессии закрыть позицию и не входить
BRACKET_SESSION_GUARD_MIN=5

# При docker stop закрыть позиции и снять ордера
CLOSE_ON_EXIT=false

BOT_ID=br1
DRY_RUN=true
# Отдельный аккаунт — весь лимит API наш
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_RESERVE=8
LOG_LEVEL=INFO
