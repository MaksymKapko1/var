# ===== Ключи Variational (testnet.variational.io/app/settings -> API) =====
VAR_API_KEY=
VAR_API_SECRET=
VAR_BASE_URL=https://api.testnet.variational.io/v1

# Приватный ключ EVM-кошелька, с которым ты логинишься на testnet.
# Нужен, чтобы подписывать permit на внесение маржи (USDC) в settlement pool при сделке.
# ТОЛЬКО тестовый кошелёк! Не клади сюда ключ кошелька с реальными деньгами.
WALLET_PRIVATE_KEY=

# ===== Инструмент =====
UNDERLYING=ETH
INSTRUMENT_TYPE=perpetual_future   # perpetual_future | spot
SETTLEMENT_ASSET=USDC

# ===== Сетка =====
GRID_LOWER=2800
GRID_UPPER=3600
GRID_LEVELS=9          # кол-во уровней (ячеек = уровни - 1)
ORDER_QTY=0.01         # размер одной сделки в базовом активе

# ===== Исполнение =====
POLL_INTERVAL_SEC=5    # как часто проверять цену
RFQ_TTL_SEC=30         # время жизни RFQ
QUOTE_WAIT_SEC=10      # сколько ждать котировки от маркет-мейкеров
MAX_SLIPPAGE_PCT=0.5   # не брать котировку хуже mark price на X%

DRY_RUN=true           # true = только логирует, сделок не делает. Поставь false для торговли
STATE_FILE=/data/state.json
LOG_LEVEL=INFO
