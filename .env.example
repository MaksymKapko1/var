# =====================================================================
#  Variational Omni grid bot — конфиг. Скопируй в .env и заполни.
# =====================================================================

# ---- Ключ API (Omni testnet -> API keys, scope ОБЯЗАТЕЛЬНО "trade") ----
# приватный Ed25519 ключ, 64 hex (показывается один раз)
VAR_API_SECRET=
# публичный 0x... — можно не заполнять, бот выведет его сам
VAR_API_KEY=
VAR_BASE_URL=https://api.omni.testnet.variational.io
VAR_ENVIRONMENT=testnet

# ---- Сетка ----
SYMBOL=ETH-PERP            # список: make check

# Режим 1 (по умолчанию): АВТО-сетка вокруг текущей цены — для частых сделок на тестнете.
GRID_STEP_PCT=0.1          # шаг между уровнями в %: 0.1% у ETH ≈ 1.7$. Меньше шаг = чаще сделки
GRID_LEVELS=10             # 3..50 уровней, ордеров на сетке = уровни-1 (сетка ±0.45% от цены)

# Режим 2: фиксированный диапазон (тогда GRID_STEP_PCT оставь пустым)
GRID_LOWER=
GRID_UPPER=

# Размер — задай ОДНО из двух, второе оставь пустым:
GRID_BALANCE_PCT=10        # % equity на ВСЮ сетку (объём, не маржа). 10 = 10% баланса
# или фикс: монет на ОДИН ордер, напр. 0.05
ORDER_SIZE=

TRIGGER_BY=quote           # quote (цена котировки OLP) | mark
MAX_SLIPPAGE=0.02          # лимит отклонения от mark для лимиток (0.02 = 2%), none = без лимита

# ---- Риск / перестройка ----
RANGE_EXIT_ACTION=recenter # цена вышла за сетку ->
                           #   recenter: снять ордера и ПЕРЕСТРОИТЬ сетку вокруг новой цены (только авто-режим)
                           #   pause   : снять ордера, ждать возврата цены и перестроить
                           #   close   : снять ордера, закрыть позицию, СТОП
                           #   none    : ничего не делать
RANGE_EXIT_PCT=0           # насколько % цена должна выйти за крайний уровень (авто: 0, фикс: 3)
RECENTER_FLATTEN=true      # при перестройке закрывать позицию по рынку (позиция не копится)
RECENTER_MIN_SEC=60        # не перестраивать чаще раза в N секунд
# стоп по PnL позиции (напр. 200): закрыть позицию + СТОП. Пусто = выкл
MAX_LOSS_USDC=
MAX_POSITION_MULT=1.5      # аварийный стоп, если позиция > 1.5 × (уровни-1) × размер
CLOSE_MAX_SLIPPAGE=0.05    # slippage для закрытия позиции по рынку (растёт с каждой попыткой)

# Что делать при docker stop / деплое:
CANCEL_ON_EXIT=false       # false = ордера остаются, после рестарта бот продолжает с места (рекомендуется)
CLOSE_ON_EXIT=false        # true = при остановке снять ордера И закрыть позицию

# ---- Работа ----
BOT_ID=grid1               # префикс client_order_id, [A-Za-z0-9_] до 10 символов, свой у каждого бота
DRY_RUN=true               # true = только план в логах, ордера НЕ ставятся
POLL_INTERVAL_SEC=10       # сверка ордеров
RISK_CHECK_SEC=15          # проверка цены/позиции/стопов/перестройки
RATE_LIMIT_PER_MIN=60      # лимит API (weight/мин)
RATE_LIMIT_RESERVE=8       # резерв weight для отмены/закрытия в экстренной ситуации
WATCHDOG_SEC=300           # если бот завис дольше — процесс перезапускается
LOG_LEVEL=INFO
