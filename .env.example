# ===== Ключ Omni API (testnet: omni.testnet.variational.io -> создать API key) =====
# Публичный ключ: 0x + 64 hex. Можно не указывать — он выводится из приватного.
VAR_API_KEY=
# Приватный Ed25519 ключ (32 байта в hex), показывается один раз при создании ключа.
# Ключу нужен scope "trade" (read-only не сможет ставить ордера).
VAR_API_SECRET=
VAR_BASE_URL=https://api.omni.testnet.variational.io
VAR_ENVIRONMENT=testnet

# ===== Инструмент (список: docker compose run --rm gridbot check) =====
SYMBOL=ETH-PERP

# ===== Сетка =====
GRID_LOWER=1600
GRID_UPPER=1770
GRID_LEVELS=10         # 3..50 уровней; ордеров на сетке = уровни - 1
# Размер — задай ОДНО из двух (второе оставь пустым):
GRID_BALANCE_PCT=10    # % от equity на ВСЮ сетку (сумма всех ордеров). 10 = 10% баланса
ORDER_SIZE=            # или фикс: монет на ОДИН ордер, напр. 0.05 (ETH)
TRIGGER_BY=quote       # quote (по цене котировки OLP) | mark
MAX_SLIPPAGE=0.02      # 0.02 = 2% от mark; none = без ограничения

# ===== Работа =====
BOT_ID=grid1           # префикс client_order_id, 1-10 символов [A-Za-z0-9_]; разный для каждого бота
POLL_INTERVAL_SEC=15   # лимит API 60 weight/мин — не ставь меньше ~10
DRY_RUN=true           # true = только показывает план, ордера НЕ ставит
CANCEL_ON_EXIT=true    # при docker stop отменить ордера бота (позиция остаётся!)
STATE_FILE=/data/state.json
LOG_LEVEL=INFO
