# =====================================================================
#  РОТАЦИЯ: рыночные позиции по списку, переоткрытие раз в N минут.
#  Скопируй в .env.rotation и заполни. Запуск: make rot-check, make rot-up
# =====================================================================
STRATEGY=rotation

# приватный Ed25519 ключ со scope "trade" (можно тот же, что в .env)
VAR_API_SECRET=
VAR_BASE_URL=https://api.omni.testnet.variational.io
VAR_ENVIRONMENT=testnet

# Ноги: SYMBOL:long|short через запятую
ROTATION_LEGS=BTC-PERP:long,ETH-PERP:short,HYPE-PERP:long,SOL-PERP:short

# Маржа на ногу, USDC. Объём позиции = маржа × плечо рынка (плечо берётся из аккаунта, напр. 50x -> 5000$)
ROTATION_MARGIN_USDC=100
# Либо задать объём напрямую (без учёта плеча), напр. 500. Пусто = считать от маржи
ROTATION_NOTIONAL_USDC=

# Закрыть и открыть все позиции заново раз в N минут
ROTATION_INTERVAL_MIN=60
# Как часто проверять, что все позиции на месте (добирает пропавшие), сек
ROTATION_CHECK_SEC=60
# Допустимое проскальзывание рыночного ордера (0.01 = 1%), растёт при повторах
ROTATION_MAX_SLIPPAGE=0.01

# При docker stop закрыть все позиции ротации
CLOSE_ON_EXIT=false

BOT_ID=rot1
DRY_RUN=true
# Лимит API общий на аккаунт (60 weight/мин). Если грид работает на том же ключе — по 30 каждому
RATE_LIMIT_PER_MIN=30
RATE_LIMIT_RESERVE=6
LOG_LEVEL=INFO
